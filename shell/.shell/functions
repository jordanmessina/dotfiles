if command -v bat &> /dev/null; then
    alias cat='bat'
fi

# Get IP address information
myip() {
    local internal_ip external_ip
    
    # Get internal IP address
    if [[ "$OSTYPE" == "darwin"* ]]; then
        # macOS method
        internal_ip=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || echo "Not connected")
    elif [[ "$OSTYPE" == "linux-gnu"* ]]; then
        # Linux method - try multiple approaches
        if command -v ip &> /dev/null; then
            internal_ip=$(ip route get 1.1.1.1 2>/dev/null | grep -oP 'src \K\S+' || echo "Not connected")
        elif command -v hostname &> /dev/null; then
            internal_ip=$(hostname -I | awk '{print $1}' 2>/dev/null || echo "Not connected")
        else
            internal_ip="ip or hostname command required"
        fi
    else
        internal_ip="Unknown OS"
    fi
    
    # Get external IP address
    if command -v curl &> /dev/null; then
        external_ip=$(curl -s https://ipinfo.io/ip 2>/dev/null || echo "Not connected")
    elif command -v wget &> /dev/null; then
        external_ip=$(wget -qO- https://ipinfo.io/ip 2>/dev/null || echo "Not connected")
    else
        external_ip="curl or wget required"
    fi
    
    echo "Internal IP: $internal_ip"
    echo "External IP: $external_ip"
}

# Git utilities (requires fzf)
fzf_git_add() {
    if command -v fzf &> /dev/null; then
        local selections=$(git ls-files -m -o --exclude-standard | \
            fzf --ansi \
              --preview 'if (git ls-files --error-unmatch {1} &>/dev/null); then 
                            git diff --color=always {1} 
                          else 
                            bat --color=always --line-range :500 {1} 
                          fi')
        if [[ -n $selections ]]; then
            git add --verbose $selections
        fi
    else
        echo "fzf not found"
    fi
}
alias gadd='fzf_git_add'

fzf_git_branch() {
    if command -v fzf &> /dev/null; then
        local branch=$(git branch --all | grep -v HEAD | fzf --ansi)
        if [[ -n "$branch" ]]; then
            git checkout $(echo "$branch" | sed "s/.* //" | sed "s#remotes/[^/]*/##")
        fi
    else
        echo "fzf not found"
    fi
}
alias gbr='fzf_git_branch'